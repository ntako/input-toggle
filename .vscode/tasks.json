{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "make build",
        },
        {
            "label": "Install",
            "type": "shell",
            "command": "make install",
            "dependsOn": [
                "Build"
            ]
        },
        {
            "label": "Enable",
            "type": "shell",
            "command": "make enable",
            "dependsOn": [
                "Build",
                "Install"
            ]
        },
        {
            "label": "Run",
            "type": "shell",
            "command": "make run",
            "dependsOn": [
                "Build",
                "Install",
                "Enable"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "make clean",
        }
    ]
}