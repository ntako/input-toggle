<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="com.ntako.input-toggle">
    <description>Gestione dispositivi input (inibizione/attivazione)</description>
    <message>Autorizzazione richiesta per attivare o disattivare dispositivi input</message>
    <defaults>
      <!-- auth_admin = solo l'amministratore può autorizzare,
           auth_admin_keep = chiede solo la prima volta e ricorda, 
           yes = non chiede mai (opzionale ma più permissivo) -->
      <allow_any>yes</allow_any>
      <allow_inactive>yes</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/com.ntako.input-toggle.sh</annotate>
  </action>
</policyconfig>